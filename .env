# Copy to backend/.env and fill in. Never commit the real .env.

PORT=5000
# Public URL of the site. Use your https:// domain in production (enables Secure cookies).
APP_URL=http://localhost:5173
# Comma-separated list of origins allowed by CORS
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# --- Database (MongoDB Atlas → Connect → Drivers) ---
# Leave empty to use a temporary in-memory database (data is wiped on restart).
# SRV form (needs DNS TXT lookups, which time out on this network):
# MONGODB_URI=mongodb+srv://otpog23:otpog55@cluster0.kcfpyzw.mongodb.net/glowmarket?retryWrites=true&w=majority&appName=Cluster0
MONGODB_URI=mongodb://otpog23:otpog55@ac-47bwyic-shard-00-00.kcfpyzw.mongodb.net:27017,ac-47bwyic-shard-00-01.kcfpyzw.mongodb.net:27017,ac-47bwyic-shard-00-02.kcfpyzw.mongodb.net:27017/glowmarket?tls=true&replicaSet=atlas-8y14gm-shard-0&authSource=admin&retryWrites=true&w=majority&appName=Cluster0
# true/false: add sample listings when the marketplace is empty (default: only for the temporary DB)
SEED_SAMPLE_DATA=

# --- Security ---
# Long random string; keeps sign-in codes valid across restarts.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=12249cd12e1e5319ae579fb35539ce0e622055f9b113567cee5a2345dd605c8a
SESSION_DAYS=30
# Key that unlocks a beautician plan while payments aren't live
ACCESS_KEY=OPEN-ME

# --- Email (sign-up / sign-in codes) ---
# Leave SMTP_HOST empty to print codes in this terminal instead of emailing them.
# Gmail: host smtp.gmail.com, port 465, SMTP_SECURE=true, user = your Gmail, pass = an App Password
# Brevo: host smtp-relay.brevo.com, port 587, SMTP_SECURE=false, user/pass from Brevo → SMTP & API
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=otpog23@gmail.com
SMTP_PASS=hdkbzksbtiqtgvrj
MAIL_FROM=GlowConnect <otpog23@gmail.com>
